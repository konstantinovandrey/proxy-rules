{
  // Complete v2ray / Xray Config Example
  // Replace UUID and YOUR_SERVER with real values.
  "log": {
    "loglevel": "warning"
  },

  "inbounds": [
    {
      "port": 1080,
      "listen": "127.0.0.1",
      "protocol": "socks",
      "settings": { "udp": true },
      "tag": "socks-in"
    },
    {
      "port": 1081,
      "listen": "127.0.0.1",
      "protocol": "http",
      "tag": "http-in"
    }
  ],

  "outbounds": [
    {
      "protocol": "vless",
      "settings": {
        "vnext": [{
          "address": "YOUR_SERVER",
          "port": 443,
          "users": [{ "id": "YOUR_UUID", "encryption": "none", "flow": "xtls-rprx-vision" }]
        }]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "tls",
        "tlsSettings": { "serverName": "YOUR_SERVER" }
      },
      "tag": "proxy"
    },
    {
      "protocol": "freedom",
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    }
  ],

  "dns": {
    "servers": [
      "https+local://dns.google/dns-query",
      "https+local://cloudflare-dns.com/dns-query",
      "localhost"
    ]
  }
}
